/// Direct manufacture facade over canonical Product, publication and transport state.
module soulidity_maker_manufacturing::maker_factory;
use soulidity_maker_manufacturing::maker_catalog::{Self as catalog,Product,Control,Session};
use soulidity_maker_manufacturing::maker_player::{Self as player,Player};
use soulidity_maker_manufacturing::maker_release as release;
use soulidity_foundation::economics::{Self,Config,Admin};
use soulidity_foundation::package_roles::RoleCertificate;
use sui::package::{Publisher,UpgradeCap};
use soulidity_origin_protocol::producer_origin::{OriginRequest,Snapshot,CompletionAuthorization};
use soulidity_model::policy::Layout;
use sui::coin::Coin;
use sui::clock::Clock;
use std::string::String;
use walrus::system::System;
/// Maintainer release operation using actual module Publishers and latest Cap.
/// Frozen public certificates are metadata proofs, not online governance caps.
public fun attest_bootstrap(creator_publisher:&Publisher,release_publisher:&Publisher,cap:&UpgradeCap,ctx:&mut TxContext):(ID,ID){let creator=catalog::attest_role(creator_publisher,cap,ctx);let release=release::attest_role(release_publisher,cap,ctx);(release,creator)}
/// Fresh self-managed service; disabled globally and both gates initially false.
/// Source/ABI hashes retain their existing build-declaration semantics.
public fun new_service<C>(release_certificate:&RoleCertificate<release::ReleaseInstaller1,release::ReleaseRevision3>,creator_certificate:&RoleCertificate<catalog::CreatorAuthority1,catalog::CreatorRevision3>,primary:u16,secondary:u16,fixed:u64,recipient:address,system:&System,source:vector<u8>,abi:vector<u8>,ctx:&mut TxContext):(Config<C>,Admin){release::new_service(release_certificate,creator_certificate,primary,secondary,fixed,recipient,system,source,abi,ctx)}
public fun create_service<C>(release_certificate:&RoleCertificate<release::ReleaseInstaller1,release::ReleaseRevision3>,creator_certificate:&RoleCertificate<catalog::CreatorAuthority1,catalog::CreatorRevision3>,primary:u16,secondary:u16,fixed:u64,recipient:address,system:&System,source:vector<u8>,abi:vector<u8>,ctx:&mut TxContext):ID{let(cfg,admin)=new_service<C>(release_certificate,creator_certificate,primary,secondary,fixed,recipient,system,source,abi,ctx);economics::finalize_manufacturing_instance(cfg,admin,ctx)}
public fun create_maker<C>(cfg:&Config<C>,royalty:u16,system:&System,ctx:&mut TxContext):ID{release::assert_catalog(cfg,system);catalog::create_maker(cfg,royalty,ctx)}
public fun create_pack<C>(maker:&Product<C>,parent_version:u64,control:&mut Control,cfg:&Config<C>,royalty:u16,system:&System,ctx:&mut TxContext):ID{release::assert_current(maker,cfg,parent_version,system);catalog::create_pack(maker,parent_version,control,cfg,royalty,ctx)}
public fun claim_access<C>(p:&mut Product<C>,cfg:&Config<C>,version:u64,hash:vector<u8>,revision:u64,expiry:u64,attempt:vector<u8>,system:&System,clock:&Clock,ctx:&mut TxContext){release::assert_current(p,cfg,version,system);catalog::claim_access(p,cfg,version,hash,revision,expiry,attempt,clock,ctx)}
public fun buy_access<C>(p:&mut Product<C>,cfg:&mut Config<C>,version:u64,hash:vector<u8>,revision:u64,expiry:u64,attempt:vector<u8>,payment:Coin<C>,system:&System,clock:&Clock,ctx:&mut TxContext){release::assert_current(p,cfg,version,system);catalog::buy_access(p,cfg,version,hash,revision,expiry,attempt,payment,clock,ctx)}
public fun create_player<C>(p:&mut Product<C>,cfg:&Config<C>,version:u64,revision:u64,expiry:u64,attempt:vector<u8>,system:&System,clock:&Clock,ctx:&mut TxContext):ID{release::assert_current(p,cfg,version,system);player::create(p,cfg,version,revision,expiry,attempt,clock,ctx)}
public fun set_player_base<C>(p:&mut Player,maker:&Product<C>,cfg:&Config<C>,definition:vector<u8>,layout:Layout,expected:u64,revision:u64,expiry:u64,system:&System,clock:&Clock,ctx:&TxContext){release::assert_current(maker,cfg,player::maker_version(p),system);player::set_base(p,maker,cfg,definition,layout,expected,revision,expiry,clock,ctx)}
public fun set_player_pack<C>(p:&mut Player,maker:&Product<C>,pack:&Product<C>,cfg:&Config<C>,version:u64,definition:vector<u8>,layout:Layout,expected:u64,revision:u64,expiry:u64,system:&System,clock:&Clock,ctx:&TxContext){release::assert_current(maker,cfg,player::maker_version(p),system);release::assert_current(pack,cfg,version,system);player::set_pack(p,maker,pack,cfg,version,definition,layout,expected,revision,expiry,clock,ctx)}
public fun request<C,A:drop,R:drop,T:key>(p:&Product<C>,cfg:&Config<C>,version:u64,hash:vector<u8>,name:String,attempt:vector<u8>,expiry:u64,a:A,r:R,system:&System,clock:&Clock,ctx:&TxContext):OriginRequest{release::assert_current(p,cfg,version,system);catalog::request_origin<C,A,R,T>(p,cfg,version,hash,name,attempt,expiry,a,r,clock,ctx)}
public fun begin<C,A:drop,R:drop,T:key>(p:&mut Product<C>,target:&T,cfg:&mut Config<C>,snapshot:Snapshot,payment:Coin<C>,a:A,r:R,system:&System,clock:&Clock,ctx:&mut TxContext):Session{release::assert_current(p,cfg,soulidity_origin_protocol::producer_origin::version(&snapshot),system);{let guard=release::availability(p,target,cfg,snapshot,system);catalog::begin_session(p,target,cfg,snapshot,payment,a,r,clock,ctx,guard)}}
public fun finish<C,A:drop,R:drop,T:key>(session:Session,target:&T,cfg:&Config<C>,a:A,r:R,system:&System,clock:&Clock,ctx:&TxContext):CompletionAuthorization{catalog::finish_session(session,target,cfg,a,r,system,clock,ctx)}

public fun begin_pack<C,A:drop,R:drop,T:key>(pack:&mut Product<C>,maker:&Product<C>,target:&T,cfg:&mut Config<C>,snapshot:Snapshot,payment:Coin<C>,a:A,r:R,system:&System,clock:&Clock,ctx:&mut TxContext):Session{release::assert_current(maker,cfg,catalog::publication_parent_version(&catalog::publication(catalog::published(pack,soulidity_origin_protocol::producer_origin::version(&snapshot))).destroy_some()),system);release::assert_current(pack,cfg,soulidity_origin_protocol::producer_origin::version(&snapshot),system);{let guard=release::availability(pack,target,cfg,snapshot,system);catalog::begin_pack_session(pack,maker,target,cfg,snapshot,payment,a,r,clock,ctx,guard)}}

public fun request_contribution<C,A:drop,R:drop,T:key>(p:&Product<C>,target:&T,cfg:&Config<C>,version:u64,hash:vector<u8>,name:String,attempt:vector<u8>,expiry:u64,a:A,r:R,system:&System,clock:&Clock,ctx:&TxContext):Snapshot{release::assert_current(p,cfg,version,system);catalog::request_contribution(p,target,cfg,version,hash,name,attempt,expiry,a,r,clock,ctx)}
public fun bind_physical<C,W:drop,R:drop,T:key>(p:&mut Product<C>,control:&mut Control,version:u64,registry:&T,cfg:&Config<C>,w:W,r:R,system:&System){release::assert_current(p,cfg,version,system);catalog::bind_manufacturing_physical_registry(p,control,version,registry,cfg,w,r)}
public fun settle_physical<C,W:drop,R:drop,T:key>(p:&mut Product<C>,registry:&T,version:u64,cfg:&mut Config<C>,receipt:economics::PrimaryReceipt,payment:Coin<C>,w:W,r:R,system:&System,clock:&Clock,ctx:&mut TxContext):catalog::PhysicalSettlement{release::assert_current(p,cfg,version,system);catalog::settle_manufacturing_physical(p,registry,version,cfg,receipt,payment,w,r,clock,ctx)}

public fun begin_native<C,A:drop,R:drop,T:key>(p:&mut Product<C>,target:&T,cfg:&mut Config<C>,snapshot:Snapshot,payment:Coin<C>,a:A,r:R,system:&System,clock:&Clock,ctx:&mut TxContext):Session{let guard=release::availability(p,target,cfg,snapshot,system);catalog::begin_native_session(p,target,cfg,snapshot,payment,a,r,clock,ctx,guard)}
public fun begin_native_pack<C,A:drop,R:drop,T:key>(pack:&mut Product<C>,maker:&Product<C>,target:&T,cfg:&mut Config<C>,snapshot:Snapshot,payment:Coin<C>,a:A,r:R,system:&System,clock:&Clock,ctx:&mut TxContext):Session{release::assert_current(maker,cfg,catalog::publication_parent_version(&catalog::publication(catalog::published(pack,soulidity_origin_protocol::producer_origin::version(&snapshot))).destroy_some()),system);let guard=release::availability(pack,target,cfg,snapshot,system);catalog::begin_native_pack_session(pack,maker,target,cfg,snapshot,payment,a,r,clock,ctx,guard)}

public fun create_native_pack<C,A:drop,R:drop,T:key>(maker:&Product<C>,parent_version:u64,control:&mut Control,cfg:&Config<C>,royalty:u16,a:A,r:R,system:&System,ctx:&mut TxContext):ID{release::assert_current(maker,cfg,parent_version,system);catalog::create_pack_native<C,A,R,T>(maker,parent_version,control,cfg,royalty,ctx,a,r)}
public fun buy_native_access<C,A:drop,R:drop,T:key>(p:&mut Product<C>,cfg:&mut Config<C>,version:u64,hash:vector<u8>,revision:u64,expiry:u64,attempt:vector<u8>,payment:Coin<C>,a:A,r:R,system:&System,clock:&Clock,ctx:&mut TxContext){release::assert_current(p,cfg,version,system);catalog::buy_access_native<C,A,R,T>(p,cfg,version,hash,revision,expiry,attempt,payment,clock,ctx,a,r)}
public fun claim_native_access<C,A:drop,R:drop,T:key>(p:&mut Product<C>,cfg:&Config<C>,version:u64,hash:vector<u8>,revision:u64,expiry:u64,attempt:vector<u8>,a:A,r:R,system:&System,clock:&Clock,ctx:&mut TxContext){release::assert_current(p,cfg,version,system);catalog::claim_access_native<C,A,R,T>(p,cfg,version,hash,revision,expiry,attempt,clock,ctx,a,r)}
public fun ensure_native_access<C,A:drop,R:drop,T:key>(p:&mut Product<C>,cfg:&Config<C>,version:u64,attempt:vector<u8>,revision:u64,expiry:u64,a:A,r:R,system:&System,clock:&Clock,ctx:&mut TxContext){release::assert_current(p,cfg,version,system);catalog::ensure_access_native<C,A,R,T>(p,cfg,version,attempt,revision,expiry,clock,ctx,a,r)}
public fun collect_native_primary<C,A:drop,R:drop,T:key>(p:&mut Product<C>,cfg:&mut Config<C>,version:u64,receipt:economics::PrimaryReceipt,payment:Coin<C>,a:A,r:R,system:&System,clock:&Clock,ctx:&mut TxContext){release::assert_current(p,cfg,version,system);catalog::assert_execution<A,R,T>(catalog::published(p,version),a,r);assert!(economics::primary_receipt_commitment(&receipt)==catalog::policy_hash(catalog::published(p,version)),1);catalog::collect_primary_value_for_factory(p,cfg,receipt,payment,clock,ctx)}
public fun create_native_player<C,A:drop,R:drop,T:key>(p:&mut Product<C>,cfg:&Config<C>,version:u64,revision:u64,expiry:u64,attempt:vector<u8>,a:A,r:R,system:&System,clock:&Clock,ctx:&mut TxContext):ID{release::assert_current(p,cfg,version,system);player::create_native<C,A,R,T>(p,cfg,version,revision,expiry,attempt,clock,ctx,a,r)}
public fun set_native_player_base<C,A:drop,R:drop,T:key>(p:&mut Player,maker:&Product<C>,cfg:&Config<C>,definition:vector<u8>,layout:Layout,expected:u64,revision:u64,expiry:u64,a:A,r:R,system:&System,clock:&Clock,ctx:&TxContext){release::assert_current(maker,cfg,player::maker_version(p),system);player::set_base_native<C,A,R,T>(p,maker,cfg,definition,layout,expected,revision,expiry,clock,ctx,a,r)}
public fun set_native_player_pack<C,A:drop,R:drop,T:key>(p:&mut Player,maker:&Product<C>,pack:&Product<C>,cfg:&Config<C>,version:u64,definition:vector<u8>,layout:Layout,expected:u64,revision:u64,expiry:u64,a:A,r:R,system:&System,clock:&Clock,ctx:&TxContext){release::assert_current(maker,cfg,player::maker_version(p),system);release::assert_current(pack,cfg,version,system);player::set_pack_native<C,A,R,T>(p,maker,pack,cfg,version,definition,layout,expected,revision,expiry,clock,ctx,a,r)}

public fun bind_native_physical<C,W:drop,R:drop,T:key>(p:&mut Product<C>,control:&mut Control,version:u64,registry:&T,cfg:&Config<C>,w:W,r:R,system:&System){release::assert_current(p,cfg,version,system);catalog::bind_physical_registry(p,control,version,registry,cfg,w,r)}
public fun settle_native_physical<C,W:drop,R:drop,T:key>(p:&mut Product<C>,registry:&T,version:u64,cfg:&mut Config<C>,receipt:economics::PrimaryReceipt,payment:Coin<C>,w:W,r:R,system:&System,clock:&Clock,ctx:&mut TxContext):catalog::PhysicalSettlement{release::assert_current(p,cfg,version,system);catalog::settle_physical(p,registry,version,cfg,receipt,payment,w,r,clock,ctx)}

/// Candidate-only generic producer interface; no Standard dependency.
public fun request_with_witness<C,A:drop,R:drop,T:key>(p:&Product<C>,cfg:&Config<C>,version:u64,hash:vector<u8>,name:String,attempt:vector<u8>,expiry:u64,a:A,r:R,system:&System,clock:&Clock,ctx:&TxContext):(OriginRequest,catalog::SoulProducer){release::assert_current(p,cfg,version,system);catalog::request_origin_with_witness<C,A,R,T>(p,cfg,version,hash,name,attempt,expiry,a,r,clock,ctx)}
