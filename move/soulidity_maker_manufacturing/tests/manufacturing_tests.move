fun setup_pack(f:&mut F,price:u64):(Product<USD>,Control){
 let id=factory::create_pack(&f.p,1,&mut f.control,&f.cfg,0,&f.system,f.sc.ctx());f.sc.next_tx(@0xa);let mut pack:Product<USD> =f.sc.take_shared_by_id(id);let mut control:Control=f.sc.take_from_sender();assert!(catalog::control_product(&control)==id,110);
 let seed=catalog::with_pack_key(catalog::with_execution<Adapter,Revision1,Target>(catalog::version(h(4),h(5),2,0,if(price==0)0 else 1,price,0,0,0,@0xd,soulidity_maker_terms::maker_resale::rates(0,0),vector[b"free"],vector[],vector[],vector[],scene()),Adapter{},Revision1{}),b"pack");
 let mut m=metadata::start(&pack,&mut control,&f.cfg,0,seed,&f.system,f.sc.ctx());metadata::append_definitions(&mut m,&pack,&mut control,&f.cfg,vector[pack_definition()],&f.system,0,f.sc.ctx());let hash=metadata::policy_hash(&m);let living=storage::blob(&mut f.system,110,false,true,f.sc.ctx());let manifest=storage::blob(&mut f.system,111,false,true,f.sc.ctx());let mut draft=metadata::begin_publication(m,&pack,&mut control,&f.cfg,1,hash,release::author(b"Pack",vector[],vector[],b"license",h(3)),living,manifest,&f.system,f.sc.ctx());let blob=storage::blob(&mut f.system,112,false,true,f.sc.ctx());release::append(&mut draft,&pack,&mut control,&f.cfg,h(13),false,h(13),blob,&f.system,0,f.sc.ctx());release::finish(draft,&mut pack,&mut control,&f.cfg,&f.system,1,f.sc.ctx());(pack,control)
}
fun pack_snapshot(f:&mut F,pack:&Product<USD>,target:&Target,attempt:u8):Snapshot{factory::request_contribution(pack,target,&f.cfg,1,catalog::policy_hash(catalog::published(pack,1)),string::utf8(b"Generic"),h(attempt),expiry(f),Adapter{},Revision1{},&f.system,&f.clock,f.sc.ctx())}
fun select_target(f:&mut F,product:&mut Product<USD>,target:&mut Target,session:&mut Session,definition:policy::Definition){let(permit,selection)=catalog::select(session,product,target,policy::definition_hash(&definition),f.sc.ctx());let(source,item)=components::materialize(permit,object::id(target),f.sc.ctx());target.sources.push_back(source);item.do!(|item|target.items.push_back(item));catalog::selected(session,selection,target,Adapter{},Revision1{},f.sc.ctx())}
