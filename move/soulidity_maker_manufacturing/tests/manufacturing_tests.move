/// Bootstrap and Walrus BLS certification are explicitly VM fixtures.
/// Subsequent Product/Control/Catalog/System/Coin/session paths are production functions.
fun setup(paid:bool):F{
 let mut sc=test_scenario::begin(@0xa);let(nodes,clock)=storage::bootstrap(&mut sc);kinds::init_for_testing(sc.ctx());let mut system:System=sc.take_shared();let(mut cfg,mut admin)=economics::new_config_for_testing<USD>(1000,500,if(paid)7 else 0,@0xf,sc.ctx());
 catalog::bootstrap_for_testing(&mut cfg,&mut admin);release::bootstrap_for_testing(&mut cfg,&mut admin);let rev=economics::revision(&cfg);let hash=economics::commitment(&cfg);release::install(&mut cfg,&mut admin,&system,h(80),h(81),rev,hash,sc.ctx());let rev=economics::revision(&cfg);let hash=economics::commitment(&cfg);economics::set_primary_enabled(&mut cfg,&mut admin,rev,hash,true);let rev=economics::revision(&cfg);let hash=economics::commitment(&cfg);release::activate(&mut cfg,&mut admin,&system,rev,hash);
 assert!(economics::native_snapshot(&cfg).is_none() && !package_roles::pinned(&economics::role(&cfg,0)),100);factory::create_maker(&cfg,0,&system,sc.ctx());let config=economics::share_config_for_testing(cfg,admin,sc.ctx());test_scenario::return_shared(system);sc.next_tx(@0xa);
 let cfg:Config<USD> =sc.take_shared_by_id(config);let admin:Admin=sc.take_from_sender();let mut p:Product<USD> =sc.take_shared();let mut control:Control=sc.take_from_sender();let mut system:System=sc.take_shared();
 let kinds:KindRegistry=sc.take_shared();let output=output::policy(b"default",false,vector[],h(14),true,vector[],vector[output::initial_rule(&kinds,0,document_policy::soul_doc_name(),3,0),output::initial_rule(&kinds,1,document_policy::memory_name(),3,0)]);test_scenario::return_shared(kinds);let seed=catalog::with_physical_route(catalog::with_outputs(catalog::with_execution<Adapter,Revision1,Target>(catalog::version(h(1),h(2),if(paid)1 else 0,if(paid)100 else 0,if(paid)1 else 0,if(paid)1000 else 0,0,0,0,@0xd,soulidity_maker_terms::maker_resale::rates(0,0),vector[b"free"],vector[],vector[],vector[],scene()),Adapter{},Revision1{}),vector[output]),PhysicalProducer{},PhysicalRevision1{});
 let mut m=metadata::start(&p,&mut control,&cfg,0,seed,&system,sc.ctx());metadata::append_definitions(&mut m,&p,&mut control,&cfg,vector[definition()],&system,0,sc.ctx());let hash=metadata::policy_hash(&m);let living=storage::blob(&mut system,100,false,true,sc.ctx());let manifest=storage::blob(&mut system,101,false,true,sc.ctx());let mut draft=metadata::begin_publication(m,&p,&mut control,&cfg,1,hash,release::author(b"Independent",vector[],vector[],b"license",h(3)),living,manifest,&system,sc.ctx());let blob=storage::blob(&mut system,102,false,true,sc.ctx());release::append(&mut draft,&p,&mut control,&cfg,h(11),false,h(11),blob,&system,0,sc.ctx());release::finish(draft,&mut p,&mut control,&cfg,&system,1,sc.ctx());
 F{sc,cfg,admin,p,control,system,nodes,clock,paid}
}
fun expiry(f:&F):u64{clock::timestamp_ms(&f.clock)+1000}
fun access_and_player(f:&mut F):Player{
 let exp=expiry(f);let rev=economics::revision(&f.cfg);let hash=catalog::policy_hash(catalog::published(&f.p,1));
 if(f.paid)factory::buy_access(&mut f.p,&mut f.cfg,1,hash,rev,exp,h(20),coin::mint_for_testing<USD>(100,f.sc.ctx()),&f.system,&f.clock,f.sc.ctx());
 let id=factory::create_player(&mut f.p,&f.cfg,1,rev,exp,h(21),&f.system,&f.clock,f.sc.ctx());let F{sc,cfg:_,admin:_,p:_,control:_,system:_,nodes:_,clock:_,paid:_}=f;sc.next_tx(@0xa);sc.take_from_sender_by_id(id)
}
fun begin(f:&mut F,attempt:u8,payment:u64): (Target,Session){
 let exp=expiry(f);let hash=catalog::policy_hash(catalog::published(&f.p,1));let request=factory::request<USD,Adapter,Revision1,Target>(&f.p,&f.cfg,1,hash,string::utf8(b"Generic"),h(attempt),exp,Adapter{},Revision1{},&f.system,&f.clock,f.sc.ctx());let snapshot=origin::consume_request<Target>(request,f.sc.ctx());let target=Target{id:object::new(f.sc.ctx()),origin:snapshot,sources:vector[],items:vector[]};let session=factory::begin(&mut f.p,&target,&mut f.cfg,snapshot,coin::mint_for_testing<USD>(payment,f.sc.ctx()),Adapter{},Revision1{},&f.system,&f.clock,f.sc.ctx());(target,session)
}
fun manufacture(f:&mut F,attempt:u8,payment:u64):ID{
 let(mut target,mut session)=begin(f,attempt,payment);let action=catalog::take_action(&mut session,&f.p,&target,f.sc.ctx());let (snapshot,receipt)=origin::consume_action(action,Adapter{},Revision1{},&target,0,f.sc.ctx());assert!(snapshot==target.origin && receipt==policy::hash_bytes(std::bcs::to_bytes(&catalog::session_receipt(&session))),101);
 let(permit,selection)=catalog::select(&mut session,&mut f.p,&target,policy::definition_hash(&definition()),f.sc.ctx());let(source,item)=components::materialize(permit,object::id(&target),f.sc.ctx());target.sources.push_back(source);item.do!(|item|target.items.push_back(item));catalog::selected(&mut session,selection,&target,Adapter{},Revision1{},f.sc.ctx());let completion=factory::finish(session,&target,&f.cfg,Adapter{},Revision1{},&f.system,&f.clock,f.sc.ctx());origin::consume_completion<Adapter,Revision1,Target>(completion,&target,&target.origin,f.sc.ctx());let id=object::id(&target);transfer::public_transfer(target,f.sc.sender());id
}
fun end(f:F){let F{mut sc,cfg,admin,p,control,system,nodes,clock,paid:_}=f;test_scenario::return_shared(cfg);test_scenario::return_shared(p);test_scenario::return_shared(system);test_scenario::return_to_address(@0xa,admin);test_scenario::return_to_address(@0xa,control);nodes.do!(|node|node.destroy());clock::destroy_for_testing(clock);sc.end();}
