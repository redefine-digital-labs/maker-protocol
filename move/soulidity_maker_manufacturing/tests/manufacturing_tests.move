fun paid_parent_pack_player_select_and_finish_without_native(){
 let mut f=setup(true);let(mut pack,control)=setup_pack(&mut f,333);let mut player=access_and_player(&mut f);factory::set_player_pack(&mut player,&f.p,&pack,&f.cfg,1,policy::definition_hash(&pack_definition()),policy::layout(false,0,false,0,1000000,0,vector[]),0,economics::revision(&f.cfg),expiry(&f),&f.system,&f.clock,f.sc.ctx());
 let(mut target,session)=begin(&mut f,30,1007);let snapshot=pack_snapshot(&mut f,&pack,&target,31);let mut pack_session=begin_pack_fixture(&mut f,&mut pack,&target,snapshot,333,false);let action=catalog::take_action(&mut pack_session,&pack,&target,f.sc.ctx());let(actual,_receipt)=origin::consume_action(action,Adapter{},Revision1{},&target,1,f.sc.ctx());assert!(actual==snapshot,111);select_target(&mut f,&mut pack,&mut target,&mut pack_session,pack_definition());let completion=factory::finish(pack_session,&target,&f.cfg,Adapter{},Revision1{},&f.system,&f.clock,f.sc.ctx());origin::consume_completion<Adapter,Revision1,Target>(completion,&target,&snapshot,f.sc.ctx());let completion=factory::finish(session,&target,&f.cfg,Adapter{},Revision1{},&f.system,&f.clock,f.sc.ctx());origin::consume_completion<Adapter,Revision1,Target>(completion,&target,&target.origin,f.sc.ctx());
 // Original gross-price fees floor 333*1000/10000 to 33; OC-right fees have a separate ceil rule.
 assert!(catalog::issued_count(&pack,1,policy::definition_hash(&pack_definition()))==1 && catalog::wallet_completes(&pack,1,@0xa)==1 && revenue::balance(catalog::income(&pack))==300 && revenue::balance(catalog::income(&f.p))==990 && revenue::balance(economics::income(&f.cfg))==150,112);let id=object::id(&target);transfer::public_transfer(target,@0xb);player::close(player,1,f.sc.ctx());test_scenario::return_shared(pack);f.sc.return_to_sender(control);f.sc.next_tx(@0xb);let target:Target=f.sc.take_from_sender_by_id(id);assert!(target.sources.length()==1,113);f.sc.return_to_sender(target);end(f)
}
